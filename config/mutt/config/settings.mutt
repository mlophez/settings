# vim: filetype=muttrc

# MAILCAP
set mailcap_path = ~/.config/mutt/config/mailcap

# CACHES
set header_cache = ~/.cache/mutt
set message_cachedir = ~/.cache/mutt
set tmpdir = ~/.cache/mutt/temp

# Set preffered view modes
auto_view text/html text/calendar application/ics
alternative_order text/calendar application/ics text/html text/plain text/enriched text/*

# main options
set editor = "nvim"
set envelope_from_address
set edit_headers                     # show headers when composing
set fast_reply                       # skip to compose when replying
set askcc                            # ask for CC:
set fcc_attach                       # save attachments with the body
set forward_format = "Fwd: %s"       # format of subject when forwarding
set forward_decode                   # decode when forwarding
set attribution = "On %d, %n wrote:" # format of quoting header
set reply_to                         # reply to Reply to: field
set reverse_name                     # reply as whomever it was to
set include                          # include message in replies
set forward_quote                    # include message in forwards
set text_flowed
unset sig_dashes                     # no dashes before sig
unset mime_forward                   # forward attachments as part of body
#unset help                           # No help bar at the top of index
# set status_on_top                    # Status bar on top of index
unset confirmappend      # don't ask, just do!
set quit                 # don't ask, just do!!
unset mark_old           # read/new is good enough for me
set beep_new             # bell on new mails
set pipe_decode          # strip headers and eval mimes when piping
set thorough_search      # strip headers and eval mimes before searching
set timeout = 0
set status_chars = " *%A"
set status_format = "[ Folder: %f ] [%r%m messages%?n? (%n new)?%?d? (%d to delete)?%?t? (%t tagged)? ]%>─%?p?( %p postponed )?"
set date_format = "%Y-%m-%d %H:%M"
set index_format = "[%Z] %?X?A&-? %D  %-20.20F  %s"

# set sort = reverse-last-date-received
# set sort = reverse-date

set sort = threads
set sort_aux = reverse-last-date-received

set uncollapse_jump
set sort_re
set reply_regexp = "^(([Rr][Ee]?(\[[0-9]+\])?: *)?(\[[^]]+\] *)?)*"
set quote_regexp = "^( {0,4}[>|:#%]| {0,4}[a-z0-9]+[>|]+)+"
set send_charset = "utf-8:iso-8859-1:us-ascii"
set charset = "utf-8"
set arrow_cursor = "no" # Change `color indicator` depending 
set auto_tag = true
unset wait_key
set sig_on_top = true

# Pager View Options
#set pager_index_lines = 10  # Shows 10 lines of index when pager is active
#set pager_context = 3
#set pager_stop
#set menu_scroll
#set tilde
#unset markers
# set query_command = "khard email --parsable --search-in-source-files '%s'"

# Sidebar
set sidebar_width = 50
set sidebar_short_path = yes
set sidebar_delim_chars = '/.'
set sidebar_folder_indent = yes
set sidebar_indent_string = '  '
set sidebar_format = '%B%?F? [%F]?%* %?N?%N/?%S'

# New mail
# set new_mail_command="notify-send 'New Email' '%n new messages, %u unread.' &"

##
## MAPPINGS
## 

# General rebindings
bind index G last-entry
bind index g noop
bind index gg first-entry
bind index d delete-message
bind index u undelete-message
bind index L limit
bind index <tab> sync-mailbox
bind index <space> sync-mailbox
bind index,pager R group-reply
bind pager c imap-fetch-mail
bind pager,browser gg top-page
bind pager,browser G bottom-page
bind attach <return> view-mailcap
bind editor <space> noop
bind editor <Tab> complete-query
bind editor <Tab> complete-query
bind editor ^T complete

# Movement
bind index j noop
bind pager,attach,postpone j exit
bind browser j goto-parent

bind index,browser,attach,compose,postpone k next-entry
bind index,browser,attach,compose,postpone l previous-entry
bind pager k next-line
bind pager l previous-line

bind index ñ display-message
bind pager ñ view-attachments
bind browser,postpone ñ select-entry
bind attach ñ view-mailcap

bind index,pager \Cl sidebar-prev
bind index,pager \Ck sidebar-next
bind index,pager \Cñ sidebar-open

bind index,pager \Co sidebar-open
bind index,pager \Cp sidebar-prev-new
bind index,pager \Cn sidebar-next-new
bind index,pager \Cm sidebar-toggle-visible

# bind pager \031 previous-line		# Mouse wheel
# bind pager \005 next-line		# Mouse wheel
# bind index \031 previous-undeleted	# Mouse wheel
# bind index \005 next-undeleted		# Mouse wheel
# bind index <space> collapse-thread
# bind index,pager,browser d half-down
# bind index,pager,browser u half-up
# sidebar mappings
# global index and pager shortcuts
# bind index,pager @ compose-to-sender
# bind index,pager D purge-message

bind compose g group-alternatives

##
## MACROS
##

bind index a noop
bind index i noop
bind index d noop
bind index o noop
bind index s noop

macro index ,, '<enter-command>
macro index dd '<delete-message><sync-mailbox>y'
macro index,pager  s "<pipe-message>abook --add-email-quiet<return>" "Add this sender to Abook"
#macro compose K '| pandoc --wrap=preserve -f markdown_github+escaped_line_breaks -t html -o /tmp/neomutt-alternative.html<enter><attach-file>/tmp/neomutt-alternative.html<enter>^T^Utext/html; charset=utf-8<enter><tag-entry><previous-entry><tag-entry><group-alternatives>'
macro compose K '| muttconvert<enter><attach-file>/tmp/neomutt-alternative.html<enter>^T^Utext/html; charset=utf-8<enter><tag-entry><previous-entry><tag-entry><group-alternatives>'
# macro index ,a '<save-message>=INBOX.Archivo<enter><sync-mailbox>s'

# Press A to add contact to Khard address book
# macro index,pager A \
#     "<pipe-message>khard add-email<return>" \
#     "add the sender email address to khard"

