* {
    BG:    #0d1117ff;
    BGA:   #1c2333ff;
    FG:    #cdd6f4ff;
    FGA:   #00ff99ff;
    BDR:   #33ccffcc;
    SEL:   #33ccff28;
    UGT:   #ff6b6bff;
    IMG:   #33ccffff;
    OFF:   #595969ff;
    ON:    #00ff99ff;

    font:  "Iosevka 10";
}

window {
    transparency:        "real";
    background-color:    @BG;
    text-color:          @FG;
    border:              3px solid;
    border-color:        @BDR;
    border-radius:       15px;
    width:               560px;
    anchor:              center;
}

mainbox {
    background-color:    @BG;
    children:            [ inputbar, listview ];
    spacing:             12px;
    padding:             18px;
}

inputbar {
    children:            [ textbox-prompt-colon, entry, case-indicator ];
    background-color:    @BGA;
    text-color:          @FG;
    expand:              false;
    border:              0px;
    border-radius:       10px;
    padding:             4px 8px;
}

textbox-prompt-colon {
    expand:              false;
    str:                 " ";
    background-color:    transparent;
    text-color:          @IMG;
    padding:             8px 4px 8px 8px;
}

entry {
    background-color:    transparent;
    text-color:          @FG;
    placeholder-color:   @OFF;
    expand:              true;
    horizontal-align:    0;
    placeholder:         "Buscar...";
    blink:               true;
    padding:             8px 8px 8px 4px;
}

case-indicator {
    background-color:    transparent;
    text-color:          @OFF;
    spacing:             0;
}

prompt {
    enabled:             false;
}

listview {
    background-color:    transparent;
    columns:             1;
    lines:               8;
    spacing:             2px;
    cycle:               false;
    dynamic:             true;
    layout:              vertical;
    scrollbar:           false;
}

element {
    background-color:    transparent;
    text-color:          @FG;
    orientation:         horizontal;
    border-radius:       10px;
    padding:             8px 10px;
}

element-icon {
    background-color:    transparent;
    text-color:          inherit;
    horizontal-align:    0.5;
    vertical-align:      0.5;
    size:                28px;
    border:              0px;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    expand:              true;
    horizontal-align:    0;
    vertical-align:      0.5;
    margin:              0px 0px 0px 10px;
}

element normal.urgent,
element alternate.urgent {
    background-color:    @UGT;
    text-color:          @BG;
    border-radius:       10px;
}

element normal.active,
element alternate.active {
    background-color:    @SEL;
    text-color:          @FGA;
}

element selected {
    background-color:    @SEL;
    text-color:          @IMG;
    border:              1px solid;
    border-color:        @BDR;
    border-radius:       10px;
}

element selected.urgent {
    background-color:    @UGT;
    text-color:          @BG;
}

element selected.active {
    background-color:    @SEL;
    text-color:          @FGA;
}

mode-switcher {
    background-color:    @BGA;
    border:              0px;
    border-radius:       10px;
    padding:             4px;
    spacing:             4px;
}

button {
    background-color:    transparent;
    text-color:          @OFF;
    border-radius:       8px;
    padding:             6px 12px;
}

button selected {
    background-color:    @SEL;
    text-color:          @IMG;
    border:              1px solid;
    border-color:        @BDR;
}
