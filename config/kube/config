apiVersion: v1
kind: Config
current-context: none
preferences: {}
clusters:
  - name: production
    cluster:
      server: https://F014FC5DAE0A9C41F698C9375CC5DB7D.gr7.eu-south-2.eks.amazonaws.com
      insecure-skip-tls-verify: true

  - name: secure
