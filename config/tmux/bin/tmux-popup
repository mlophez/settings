#!/bin/bash

start_session() {
  local index="$1"
  local session_name="popup"

  if tmux has-session -t $session_name 2>/dev/null; then
    tmux select-window -t ${session_name}:${index} || tmux new-window -t ${session_name}:${index}
    exec tmux attach-session -t ${session_name}
  else
    tmux new-session -d -c '#{pane_current_path}' -e TMUX_POPUP=true -s ${session_name}

    tmux set-option -t ${session_name} status off

    exec tmux attach-session -t ${session_name}
  fi
}

popup_with_session() {
  local index=$(tmux display-message -p -F "#{window_index}")
  local session_name=$(tmux display-message -p -F "#{session_name}")

  if [ "${session_name}" != "popup" ];then
    tmux display-popup -d '#{pane_current_path}' -w 95% -h 80% -E "$TMUX_PATH/bin/tmux-popup session ${index}"
  else
    tmux detach-client
    #tmux display-popup -t '#{session_name}' -C
    #tmux display-popup -t "${USER}" -C
  fi
}

popup() {
  if [ -n "${TMUX}" ];then
    tmux display-popup -d '#{pane_current_path}' -w 95% -h 80% -E
  else
    tmux display-popup -t '#{session_name}' -C
  fi
}

[ -z "$1" ] && popup "$@"
[ "$1" = "session" ] && shift && start_session "$@"

exit 0

