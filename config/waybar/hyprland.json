{
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-top": 15,
  "margin-left": 15,
  "margin-right": 25,
  "include": [
    "$HOME/.config/waybar/modules.json"
  ],
  "modules-left": [
    "hyprland/workspaces",
  ],
  "modules-center": [
    "cpu",
    "memory",
    "clock#date",
    "clock#time",
    "temperature",
    "disk",
  ],
