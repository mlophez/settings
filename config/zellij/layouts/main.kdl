layout {
  default_tab_template {
    pane size=1 borderless=true {
      plugin location="zellij:compact-bar"
    }
    pane cwd="$HOME"
  }
  swap_floating_layout {
    floating_panes max_panes=5 {
      pane { x "2%"; y "3%"; width "88%"; height "82%"; }
      pane { x "4%"; y "6%"; width "88%"; height "82%"; }
      pane { x "6%"; y "9%"; width "88%"; height "82%"; }
      pane { x "8%"; y "12%"; width "88%"; height "82%"; }
      pane { x "10%"; y "15%"; width "88%"; height "82%"; }
    }
  }
  tab name="1# LOCAL"
}
