layout {
  default_tab_template {
    pane size=1 borderless=true {
      plugin location="zellij:compact-bar"
    }
    pane cwd="$HOME"
  }
  swap_floating_layout {
    floating_panes max_panes=5 {
      pane { x "2%"; y "5%"; width "86%"; height "75%"; }
      pane { x "4%"; y "8%"; width "86%"; height "75%"; }
      pane { x "6%"; y "11%"; width "86%"; height "75%"; }
      pane { x "8%"; y "14%"; width "86%"; height "75%"; }
      pane { x "10%"; y "17%"; width "86%"; height "75%"; }
    }
  }
  tab name="1# LOCAL"
}
