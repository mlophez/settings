{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/agent/guard.sh",
            "timeout": 15,
            "statusMessage": "Checking protected paths and secrets..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/agent/after-edit.sh",
            "args": ["${tool_input.file_path}"],
            "timeout": 120,
            "statusMessage": "Formatting and linting the edited file..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/agent/validate.sh",
            "timeout": 600,
            "statusMessage": "Running project validation..."
          }
        ]
      }
    ]
  }
}
