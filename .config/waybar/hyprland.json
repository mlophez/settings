// vim: ft=json
{
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-top": 15,
  "margin-left": 15,
  "margin-right": 25,

  "include": ["~/.config/waybar/modules.json"],

  "modules-left": [
    "hyprland/workspaces",
    "custom/wallpaper"
  ],
  "modules-center": ["clock#time", "clock#date"],
  "modules-right": [
    "tray",
    "memory",
    "pulseaudio",
    "backlight",
    "battery"
  ]
}
