#!/usr/bin/env -S just --working-directory . --justfile

[private]
help:
  @desktop -u -l

# Initialize desktop environment
init: && portals wallpaper panel theme distrobox
  #!/usr/bin/env bash
  systemctl --user import-environment XDG_CURRENT_DESKTOP WAYLAND_DISPLAY
  dbus-update-activation-environment --systemd --all
  # BALOOCTL
  type balooctl &>/dev/null && \
    balooctl disable &>/dev/null
  # NETWORK MANAGER
  # type nmcli &>/dev/null && nmcli radio wifi off
  # VBOX
  # type VBoxClient &>/dev/null && VBoxClient --clipboard
  exit 0

# Start xdg-desktop-portals
portals:
  #!/usr/bin/env bash
  pkill -f "xdg-desktop-portal"
  hyprctl dispatch exec '/usr/lib/xdg-desktop-portal -r'
  hyprctl dispatch exec '/usr/lib/xdg-desktop-portal-gtk -r'
  hyprctl dispatch exec '/usr/lib/xdg-desktop-portal-hyprland'
  exit 0

# Start desktop panel
panel:
  #!/usr/bin/env bash
  if type waybar &>/dev/null; then
    pkill waybar
    hyprctl dispatch exec "waybar -c $HOME/.config/waybar/config -s $HOME/.config/waybar/style.css"
  fi
  if type nm-applet &>/dev/null; then
    pkill nm-applet
    hyprctl dispatch exec "nm-applet"
  fi
  exit 0

# Rotate/Set wallpaper
wallpaper:
  #!/usr/bin/env bash
  image=$(ls ~/.local/share/backgrounds | shuf -n 1)
  if type swww &>/dev/null; then
    if ! pgrep -x "swww-daemon" > /dev/null; then
      pkill swww
      hyprctl dispatch exec "swww init"
      swww img $HOME/.local/share/backgrounds/${image}
    else
      swww img $HOME/.local/share/backgrounds/${image} \
        --transition-type center \
        --transition-fps 60 \
        --transition-step 50 \
        --transition-duration 1
    fi
  elif [ "${XDG_CURRENT_DESKTOP,,}" = "sway" ]; then
    swaymsg output '*' bg $HOME/.local/share/backgrounds/${image} fill
    # swaymsg output * bg #1e1e2e solid_color
  fi
  exit 0

[private]
theme:
  #!/usr/bin/env bash
  local gnome_schema="org.gnome.desktop.interface"
  local cursor_theme="bibata-modern-ice-cursors"
  local gtk_theme="Catppuccin-Mocha-Standard-Peach-Dark"
  local icon_theme="cupertino-sonoma-icons"
  local font_theme="JetBrainsMono Nerd Font 14"
  [ -d "$HOME/.local/share/icons/${cursor_theme}" ] && \
    hyprctl setcursor "${cursor_theme}" 24 \
  ! type gsettings &>/dev/null && exit 0
  [ -d "$HOME/.local/share/icons/${cursor_theme}" ] && \
    gsettings set ${gnome_schema} cursor-theme "${cursor_theme}"
  [ -d "$HOME/.local/share/themes/${gtk_theme}" ] && \
    gsettings set ${gnome_schema} gtk-theme "${gtk_theme}"
    gsettings set ${gnome_schema} color-scheme 'prefer-dark'
  [ -d "$HOME/.local/share/themes/icons/${icon_theme}" ] && \
    gsettings set ${gnome_schema} icon-theme "${icon_theme}"
  gsettings set ${gnome_schema} font-name "${font_theme}"
  exit 0

[private]
distrobox:
  #!/usr/bin/env bash
  if type distrobox &>/dev/null; then
    for name in $(distrobox list --no-color | awk -F'|' '{print $2}' | grep -v "NAME" ); do
      distrobox enter ${name} -- echo
    done
  fi
  exit 0

# App launcher menu
menu:
  #!/usr/bin/env bash
  type rofi &>/dev/null && exec rofi -show drun
  [ -n "$(pidof wofi)" ] && return 0
  exec wofi -i --show drun \
      --no-actions \
      --normal-window \
      --allow-images \
      --sort-order=alphabetical \
      --parse-search \
      --lines=10 --columns=10 \
      -s $HOME/.config/sway/wofi.css
      #--matching=fuzzy \
  exit 0

# Lock screen
lock:
  #!/usr/bin/env bash
  image=$(ls ~/.local/share/backgrounds | shuf -n 1)
  [ -n "$(pacman -Q swaylock | grep effects-git)" ] && \
    exec swaylock
  swaylock swaylock -C /dev/null \
    --ignore-empty-password \
    --show-failed-attempts \
    --indicator-radius 200 \
    -f -i ~/.local/share/backgrounds/${image} -s fill
  exit 0

# Take a screenshot
screenshot:
  slurp | grim -g - - | wl-copy

# Start terminal
terminal:
  #!/usr/bin/env bash
  type alacritty &>/dev/null && exec alacritty -e desktop shell
  type wezterm &>/dev/null && exec wezterm start --always-new-process -- desktop shell
  type foot &>/dev/null && exec foot
  exit 0

[private]
shell:
  #!/usr/bin/env bash
  export ZDOTDIR=$HOME/.config/zsh
  if type zellij &>/dev/null; then
    { zellij attach '0' || exec zellij -s '0'; }; exit 0
  fi
  if type tmux &>/dev/null; then
    { tmux attach-session -t '0' || exec tmux -2 new-session -s '0' -n 'HOME'; }; exit 0
  fi
  type zsh &>/dev/null && exec zsh
  exit 0

