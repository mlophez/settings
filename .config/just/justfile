tunnel-db-mongodb:
  echo kubectl --context demo -n mongodb port-forward pods/mongo-0 27017
  echo kubectl --context demo -n mongodb port-forward pods/mongo-1 27017
  echo kubectl --context demo -n mongodb port-forward pods/mongo-2 27017

demo-mongodb-0:
  kubectl --context demo -n mongodb exec -it pod/mongo-0 -c mongo -- bash -c 'mongo -u $MONGO_INITDB_ROOT_USERNAME -p $MONGO_INITDB_ROOT_PASSWORD'

demo-mongodb-1:
  kubectl --context demo -n mongodb exec -it pod/mongo-1 -c mongo -- bash -c 'mongo -u $MONGO_INITDB_ROOT_USERNAME -p $MONGO_INITDB_ROOT_PASSWORD'

demo-mongodb-2:
  kubectl --context demo -n mongodb exec -it pod/mongo-2 -c mongo -- bash -c 'mongo -u $MONGO_INITDB_ROOT_USERNAME -p $MONGO_INITDB_ROOT_PASSWORD'

vpn-globalprotect:
