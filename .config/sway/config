# vim: ft=swayconfig
include themes/catppuccin-mocha

# Monitors
output eDP-1 resolution 1920x1080 position 0,0 scale 1
#output * bg #1e1e2e solid_color

# Autostart
exec ~/.config/sway/deskctl init

# Inputs
input "type:keyboard" {
  xkb_layout es
  #xkb_model = thinkpad
  xkb_options ctrl:nocaps
}

input "type:touchpad" {
  dwt enabled
  tap enabled
  natural_scroll enabled
  middle_emulation enabled
}

# Settings
xwayland enabled
font pango:Fira Code, Bold 14
workspace_layout default
title_align center
default_border pixel 3
default_floating_border pixel 3
hide_edge_borders none
gaps inner 5
gaps outer 10
# titlebar_border_thickness 0
# titlebar_padding 1
# hide_edge_borders smart

# Rules
for_window [app_id="menu"] floating enable; resize set 600 800; move position center
for_window [app_id="pinentry-qt"] floating enable
for_window [app_id="xdg-desktop-portal-gtk"] floating enable; resize set 1500 800; move position center
for_window [app_id="imv"] floating enable; move position center
for_window [app_id="mpv"] floating enable; move position center
for_window [app_id="nm-connection-editor"] floating enable; resize set 1000 800; move position center
for_window [app_id="pavucontrol"] floating enable; resize set 1500 800; move position center
for_window [app_id="brave-browser"] move to workspace $ws2
for_window [app_id="google-chrome"] move to workspace $ws3
for_window [app_id="org.keepassxc.KeePassXC"] move to workspace $ws7
