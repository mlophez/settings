# vim: filetype=muttrc
## Mutt configuration template

# Account config
set my_name = "Miguel López Ruiz"
set from = "miguel.lr96@hotmail.com"

set mbox_type   = Maildir
set folder      = "~/.local/mail/hotmail"
set spoolfile   = "+Inbox"
set record      = "+Sent"
set postponed   = "+Drafts"
set sendmail    = "msmtp -C $HOME/.config/mutt/config/msmtprc -a hotmail"
unmailboxes *
mailboxes `zsh -i -c 'mailboxes ~/.local/mail/trc'`

macro index aa '<save-message>=Archivo<enter><sync-mailbox>s'
macro index ii '<save-message>=Inbox<enter><sync-mailbox>s'
