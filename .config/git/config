[init]
	defaultBranch = main
[core]
	editor = nvim
	pager = delta
	hooksPath = ~/.config/git/hooks
	compression = 0
[credential]
	helper = store
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[rebase]
	autoStash = true
	autoSquash = true
