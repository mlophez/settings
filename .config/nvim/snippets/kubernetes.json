{
  "kustomization": {
    "prefix": "deployment",
    "description": "Kubernetes Deployment",
    "body": [
      "---",
      "apiVersion: apps/v1",
      "kind: Deployment",
      "metadata:",
      "  name: uaa",
      "  labels:",
      "    app.kubernetes.io/name: uaa",
      "  annotations:",
      "    reloader.stakater.com/auto: \"true\"",
      "spec:",
      "  revisionHistoryLimit: 2",
      "  replicas: 2",
      "  strategy:",
      "    rollingUpdate:",
      "      maxSurge: 25%",
      "      maxUnavailable: 0",
      "  selector:",
      "    matchLabels:",
      "      app.kubernetes.io/name: uaa",
      "  template:",
      "    metadata:",
      "      labels:",
      "        app.kubernetes.io/name: uaa",
      "    spec:",
      "      restartPolicy: Always",
      "      terminationGracePeriodSeconds: 90",
      "      securityContext:",
      "        fsGroup: 30000",
      "        runAsUser: 30000",
      "        runAsGroup: 30000",
      "        runAsNonRoot: true",
      "      topologySpreadConstraints:",
      "        - maxSkew: 1",
      "          topologyKey: \"topology.kubernetes.io/zone\"",
      "          whenUnsatisfiable: ScheduleAnyway",
      "          labelSelector:",
      "            matchLabels:",
      "              app.kubernetes.io/name: uaa",
      "        - maxSkew: 1",
      "          topologyKey: \"kubernetes.io/hostname\"",
      "          whenUnsatisfiable: DoNotSchedule",
      "          labelSelector:",
      "            matchLabels:",
      "              app.kubernetes.io/name: uaa",
      "      volumes:",
      "        - name: global",
      "          configMap:",
      "            name: global",
      "        - name: config",
      "          configMap:",
      "            name: uaa",
      "        - name: tmp",
      "          emptyDir:",
      "      containers:",
      "        - name: uaa",
      "          image: lgtjpmora/uaa:latest",
      "          imagePullPolicy: Always",
      "          securityContext:",
      "            readOnlyRootFilesystem: true",
      "            allowPrivilegeEscalation: false",
      "            capabilities:",
      "              drop: [\"ALL\"]",
      "          ports:",
      "            - name: http",
      "              containerPort: 8080",
      "          env:",
      "            - name: JAVA_OPTS",
      "              value: -Xms256m -Xmx512m",
      "            - name: SPRING_CLOUD_CONFIG_ENABLED",
      "              value: \"false\"",
      "            - name: APPLICATION_NAME",
      "              value: \"uaa\"",
      "            - name: \"SPRING_PROFILES_ACTIVE\"",
      "              value: \"main\"",
      "          volumeMounts:",
      "            - name: global",
      "              mountPath: /app/resources/config/application.yml",
      "              subPath: application.yml",
      "            - name: config",
      "              mountPath: /app/resources/config/application-main.yml",
      "              subPath: application.yml",
      "            - name: tmp",
      "              mountPath: /tmp",
      "          resources:",
      "            requests:",
      "              cpu: 10m",
      "              memory: 1024Mi",
      "            limits:",
      "              memory: 1024Mi",
      "          readinessProbe:",
      "            httpGet:",
      "              port: http",
      "              path: /management/health",
      "            initialDelaySeconds: 2",
      "            periodSeconds: 3",
      "            timeoutSeconds: 3",
      "            successThreshold: 2",
      "            failureThreshold: 2",
      ""
    ]
  }
}
