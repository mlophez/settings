apiVersion: v1
kind: Config
current-context: none
preferences: {}

clusters:

- name: demo
  cluster:
    server: https://7765F82FD0DBC9B034E8C053F844D80D.gr7.eu-south-2.eks.amazonaws.com
    certificate-authority: demo.crt

- name: tools
  cluster:
    server: https://9E8CE2F853C652CB27A80EE4C992E8FE.yl4.eu-south-2.eks.amazonaws.com
    certificate-authority: tools.crt 

- name: biiddev
  cluster:
    server: https://54.74.163.210:6443
    insecure-skip-tls-verify: true

- name: biiduat
  cluster:
    server: https://34.246.33.86:6443
    insecure-skip-tls-verify: true

- name: biidprod
  cluster:
    server: https://34.247.238.150:6443
    insecure-skip-tls-verify: true

users:
- name: terraform
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: aws
      args: ["eks", "get-token", "--cluster-name", "kubernetes", "--region", "eu-south-2", "--profile", "terraform"]

- name: demo-admin
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: aws
      args: ["eks", "get-token", "--cluster-name", "kubernetes", "--region", "eu-south-2", "--profile", "demo"]

- name: tools-admin
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: aws
      args: ["eks", "get-token", "--cluster-name", "kubernetes", "--region", "eu-south-2", "--profile", "tools"]

- name: biiddev-admin
  user:
    client-key: biiddev-admin.key
    client-certificate: biiddev-admin.crt

- name: biiduat-admin
  user:
    client-key: biiduat-admin.key
    client-certificate: biiduat-admin.crt

- name: biidprod-admin
  user:
    client-key: biidprod-admin.key
    client-certificate: biidprod-admin.crt

contexts:
- name: demo
  context:
    cluster: demo
    user: demo-admin

- name: tools
  context:
    cluster: tools
    user: tools-admin

- name: biiddev
  context:
    cluster: biiddev
    user: biiddev-admin

- name: biiduat
  context:
    cluster: biiduat
    user: biiduat-admin

- name: biidprod
  context:
    cluster: biidprod
    user: biidprod-admin
