apiVersion: v1
kind: Config
current-context: none
preferences: {}

clusters:
- name: k0s
  cluster:
    server: https://k0s.cluster.local:6443
    certificate-authority: creds.k0s.crt

- name: tools
  cluster:
    server: https://9E8CE2F853C652CB27A80EE4C992E8FE.yl4.eu-south-2.eks.amazonaws.com
    certificate-authority: creds.tools.crt 

- name: demo
  cluster:
    server: https://7765F82FD0DBC9B034E8C053F844D80D.gr7.eu-south-2.eks.amazonaws.com
    certificate-authority: creds.demo.crt

- name: biid-des
  cluster:
    server: https://54.74.163.210:6443
    insecure-skip-tls-verify: true
    #certificate-authority: creds.biid-des.crt

users:
- name: k0s
  user:
    client-certificate: creds.k0s.user.crt
    client-key: creds.k0s.user.key

- name: terraform
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: aws
      args: ["eks", "get-token", "--cluster-name", "kubernetes", "--region", "eu-south-2", "--profile", "terraform"]

- name: tools
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: aws
      args: ["eks", "get-token", "--cluster-name", "kubernetes", "--region", "eu-south-2", "--profile", "tools"]

- name: tools-operator
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: aws
      args: ["eks", "get-token", "--cluster-name", "kubernetes", "--region", "eu-south-2", "--profile", "tools-operator"]

- name: demo 
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: aws
      args: ["eks", "get-token", "--cluster-name", "kubernetes", "--region", "eu-south-2", "--profile", "demo"]

- name: demo-operator
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: aws
      args: ["eks", "get-token", "--cluster-name", "kubernetes", "--region", "eu-south-2", "--profile", "demo-operator"]

- name: demo-viewer
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: aws
      args: ["eks", "get-token", "--cluster-name", "kubernetes", "--region", "eu-south-2", "--profile", "demo-viewer"]

- name: biid-des-admin
  user:
    client-key: creds.biid-des.user.key
    client-certificate: creds.biid-des.user.crt

contexts:
- name: k0s
  context:
    cluster: k0s
    user: k0s

- name: tools
  context:
    cluster: tools
    user: tools

- name: tools-operator
  context:
    cluster: tools
    user: tools-operator

- name: demo
  context:
    cluster: demo
    user: demo

- name: demo-operator
  context:
    cluster: demo
    user: demo-operator

- name: demo-viewer
  context:
    cluster: demo
    user: demo-viewer

- name: biid-des
  context:
    cluster: biid-des
    user: biid-des-admin
