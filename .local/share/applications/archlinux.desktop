[Desktop Entry]
Name=Archlinux
GenericName=Archlinux
Comment=A fast, cross-platform, OpenGL terminal emulator
StartupWMClass=Alacritty
Type=Application
Exec=alacritty --title archlinux -e toolbox run -c archlinux bash -c 'export SHELL=/usr/bin/zsh; export ZDOTDIR=$HOME/.config/zsh; zsh'
Icon=org.gnome.Terminal
Terminal=false
Categories=System;TerminalEmulator;
